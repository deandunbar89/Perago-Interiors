generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Stage {
  LEAD
  REVIEWING
  TENDER_SUBMITTED
  WON
  LOST
  DECLINED
  ON_HOLD
}

enum DocCategory {
  DRAWING
  TENDER_DOC
  CONTRACT
  CORRESPONDENCE
  OTHER
}

enum ProjectType {
  DESIGN_BUILD
  BUILD
  PROJECT_MANAGEMENT
  CONSULTANCY
  LABOUR_SUPPLY
}

enum Temperature {
  COLD
  WARM
  HOT
}

enum TaskStatus {
  OPEN
  DONE
}

enum TaskScope {
  CRM
  PM
}

enum PmProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETE
}

enum ScheduleItemStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum PmDocCategory {
  PROCUREMENT
  DESIGN
  COMMERCIAL
  SITE_WORKS
  OPERATIONS
}

enum UploadMode {
  SINGLE
  MULTIPLE
}

enum SnagStatus {
  OPEN
  CLOSED
}

enum SnagPriority {
  LOW
  MEDIUM
  HIGH
}

enum SnagCategory {
  SNAG
  DEFECT
  PUNCH_ITEM
}

enum Trade {
  ELECTRICAL
  PLUMBING
  HVAC_MEP
  CARPENTRY
  PAINTING
  FLOORING
  CEILING
  GLAZING
  CIVIL_STRUCTURAL
  FURNITURE_JOINERY
  TILING
  OTHER
}

enum VendorType {
  SUPPLIER
  CONTRACTOR
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum VendorDocType {
  INVOICE
  PURCHASE_ORDER
  LPO
  QUOTE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  /// Which top-level sections a MEMBER can open (CRM, PM, TASKS, SNAGS, VENDORS, AI).
  /// Ignored for ADMIN users, who always have full access.
  allowedSections String[] @default([])
  createdAt    DateTime @default(now())

  projects   Project[]  @relation("ProjectOwner")
  documents  Document[]
  notes      Note[]
  emailLogs  EmailLog[]
  activities Activity[]
  tasks       Task[]
  taskNotes   TaskNote[]
  subtasks    Subtask[]
  pmProjects  PmProject[]  @relation("PmProjectOwner")
  pmDocuments PmDocument[]
  pushSubscriptions PushSubscription[]
  snags       Snag[]
  vendorDocuments VendorDocument[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Client {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  website   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   Contact[]
  projects   Project[]
  pmProjects PmProject[]
}

model Contact {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  role     String?
  email    String?
  phone    String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
}

model Project {
  id                 String       @id @default(cuid())
  title              String
  reference          String?
  stage              Stage        @default(LEAD)
  projectType        ProjectType?
  temperature        Temperature?
  value              Float?
  currency           String       @default("AED")
  location           String?
  description        String?
  contactName        String?
  contactEmail       String?
  contactPhone1      String?
  contactPhone2      String?
  submissionDeadline DateTime?
  siteVisitDate      DateTime?
  awardDate          DateTime?
  clientId           String?
  client             Client?      @relation(fields: [clientId], references: [id])
  ownerId            String?
  owner              User?        @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  documents  Document[]
  notes      Note[]
  emailLogs  EmailLog[]
  activities Activity[]
  tasks      Task[]
  subtasks   Subtask[]
  pmProject  PmProject?
}

model Document {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category     DocCategory @default(OTHER)
  originalName String
  storedName   String
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime    @default(now())
}

model Note {
  id          String     @id @default(cuid())
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pmProjectId String?
  pmProject   PmProject? @relation(fields: [pmProjectId], references: [id], onDelete: Cascade)
  subtaskId   String?
  subtask     Subtask?   @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime   @default(now())
}

model EmailLog {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject    String
  fromAddr   String
  toAddr     String
  direction  String   @default("outgoing")
  sentAt     DateTime
  body       String?
  loggedById String?
  loggedBy   User?    @relation(fields: [loggedById], references: [id])
  createdAt  DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String
  message   String
  createdAt DateTime @default(now())
}

model Task {
  id            String     @id @default(cuid())
  title         String
  dueDate       DateTime?
  status        TaskStatus @default(OPEN)
  scope         TaskScope  @default(CRM)
  autoGenerated Boolean    @default(false)
  autoKey       String?
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pmProjectId   String?
  pmProject     PmProject? @relation(fields: [pmProjectId], references: [id], onDelete: Cascade)
  createdById   String?
  createdBy     User?      @relation(fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  taskNotes TaskNote[]
  subtasks  Subtask[]

  @@unique([projectId, autoKey])
  @@unique([pmProjectId, autoKey])
}

model TaskNote {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Subtask {
  id            String     @id @default(cuid())
  taskId        String?
  task          Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pmProjectId   String?
  pmProject     PmProject? @relation(fields: [pmProjectId], references: [id], onDelete: Cascade)
  title         String
  dueDate       DateTime?
  status        TaskStatus @default(OPEN)
  scope         TaskScope  @default(CRM)
  autoGenerated Boolean    @default(false)
  autoKey       String?
  createdById   String?
  createdBy     User?      @relation(fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  notes Note[]

  @@unique([projectId, autoKey])
}

/// A live construction/fit-out project in the PM tool — created either from
/// scratch or by promoting a Won tender from the CRM (linkedTenderId).
model PmProject {
  id       String          @id @default(cuid())
  title    String
  status   PmProjectStatus @default(ACTIVE)
  value    Float?
  currency String          @default("AED")
  location String?
  description String?

  startDate      DateTime?
  targetEndDate  DateTime?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  linkedTenderId String?  @unique
  linkedTender   Project? @relation(fields: [linkedTenderId], references: [id])

  ownerId String?
  owner   User?   @relation("PmProjectOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleItems ScheduleItem[]
  tasks         Task[]
  subtasks      Subtask[]
  pmDocuments   PmDocument[]
  docSubsections PmDocSubsection[]
  notes         Note[]
  snags         Snag[]
  vendors       PmProjectVendor[]
}

model PmDocSubsection {
  id             String         @id @default(cuid())
  pmProjectId    String
  pmProject      PmProject      @relation(fields: [pmProjectId], references: [id], onDelete: Cascade)
  category       PmDocCategory
  alsoInCategory PmDocCategory?
  name           String
  mode           UploadMode     @default(MULTIPLE)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())

  documents PmDocument[]

  @@unique([pmProjectId, category, name])
}

model PmDocument {
  id                String           @id @default(cuid())
  pmProjectId       String
  pmProject         PmProject        @relation(fields: [pmProjectId], references: [id], onDelete: Cascade)
  category          PmDocCategory
  subsectionId      String?
  subsection        PmDocSubsection? @relation(fields: [subsectionId], references: [id], onDelete: Cascade)
  pmProjectVendorId String?
  pmProjectVendor   PmProjectVendor? @relation(fields: [pmProjectVendorId], references: [id], onDelete: Cascade)
  vendorDocType     VendorDocType?
  originalName      String
  storedName        String
  mimeType          String
  size              Int
  uploadedById      String?
  uploadedBy        User?            @relation(fields: [uploadedById], references: [id])
  createdAt         DateTime         @default(now())

  snagOpenFor   Snag? @relation("SnagOpenPhoto")
  snagClosedFor Snag? @relation("SnagClosedPhoto")
}

model Snag {
  id            String       @id @default(cuid())
  pmProjectId   String
  pmProject     PmProject    @relation(fields: [pmProjectId], references: [id], onDelete: Cascade)
  description   String
  status        SnagStatus   @default(OPEN)
  priority      SnagPriority @default(MEDIUM)
  category      SnagCategory @default(SNAG)
  trade         Trade?
  location      String?
  vendorId      String?
  vendor        Vendor?      @relation(fields: [vendorId], references: [id])
  openPhotoId   String       @unique
  openPhoto     PmDocument   @relation("SnagOpenPhoto", fields: [openPhotoId], references: [id])
  closedPhotoId String?      @unique
  closedPhoto   PmDocument?  @relation("SnagClosedPhoto", fields: [closedPhotoId], references: [id])
  createdById   String?
  createdBy     User?        @relation(fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  closedAt      DateTime?
}

model Vendor {
  id          String       @id @default(cuid())
  name        String
  type        VendorType
  trade       Trade?
  status      VendorStatus @default(ACTIVE)
  contactName String?
  phone       String?
  email       String?
  address     String?
  website     String?
  trnNumber   String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tradeLicenseDocId String?         @unique
  tradeLicenseDoc   VendorDocument? @relation("VendorTradeLicense", fields: [tradeLicenseDocId], references: [id])
  trnCertDocId      String?         @unique
  trnCertDoc        VendorDocument? @relation("VendorTrnCert", fields: [trnCertDocId], references: [id])

  snags       Snag[]
  pmProjects  PmProjectVendor[]
}

/// Registration documents for a vendor (trade license, TRN certificate) — not tied
/// to any project, just the vendor's own record.
model VendorDocument {
  id           String   @id @default(cuid())
  originalName String
  storedName   String
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  tradeLicenseFor Vendor? @relation("VendorTradeLicense")
  trnCertFor      Vendor? @relation("VendorTrnCert")
}

/// A vendor engaged on a specific PM project — its scope of work there, with its
/// own place to file invoices, POs, LPOs and quotes tied to that engagement.
model PmProjectVendor {
  id          String    @id @default(cuid())
  pmProjectId String
  pmProject   PmProject @relation(fields: [pmProjectId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  scope       String?
  createdAt   DateTime  @default(now())

  documents PmDocument[]

  @@unique([pmProjectId, vendorId])
}

enum AiSubscriptionStatus {
  ACTIVE
  CANCELLED
}

/// Tracks AI tool subscriptions (login, plan, renewal) for the team's own reference.
/// passwordEnc is encrypted at rest (see src/lib/crypto.ts) — never stored in plain text.
model AiSubscription {
  id           String               @id @default(cuid())
  name         String
  url          String?
  username     String?
  passwordEnc  String?
  plan         String?
  cost         String?
  renewalDate  DateTime?
  notes        String?
  status       AiSubscriptionStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model ScheduleItem {
  id              String              @id @default(cuid())
  pmProjectId     String
  pmProject       PmProject           @relation(fields: [pmProjectId], references: [id], onDelete: Cascade)
  title           String
  startDate       DateTime
  endDate         DateTime
  percentComplete Int                 @default(0)
  status          ScheduleItemStatus  @default(NOT_STARTED)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}
