# Postgres connection string (from Railway's Postgres service → "Connect" tab)
DATABASE_URL="postgresql://user:password@host:port/database"

# Random secret for signing login sessions — generate a new one for production:
# npx auth secret   (or any random 32+ character string)
AUTH_SECRET="replace-with-a-real-random-secret"

# Web push notification keys — same values in dev and prod, generate once with:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BCT_L-c3He3jP8nZfF2GNEJoM7tEV-3xZPQmD8eiG856FiXTlWy5JEwB7KCNo3CjxqnM6reTgmyHXoLS6jzT6v4"
VAPID_PRIVATE_KEY="1l20WWg8K0ti7nyU9tAauygkJmNgBZGmAOtWHhtB5ek"

# Claude coworker API (/api/agent/*). Leave AGENT_API_KEY unset to switch the API off.
# Generate a long random key (48+ characters), e.g. node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
AGENT_API_KEY=""
# The Perago user the coworkers act as (what they create is recorded under this person)
AGENT_USER_EMAIL="deandunbar@peragointeriors.ae"
